{
  "name": "deskcomm-mcp-skill",
  "version": "0.3.0",
  "description": "Instalador reproduzível da Skill e da conexão MCP do DeskcommCRM para Codex CLI e Claude Code.",
  "type": "module",
  "bin": {
    "deskcomm-mcp-skill": "bin/deskcomm-mcp-skill.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "runtime/",
    "docs/",
    "skills/",
    "templates/",
    "README.md",
    "release-manifest.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:cross-platform": "node --test tests/cross-platform.test.mjs",
    "test:mock-mcp": "node --test tests/mcp-client.test.mjs",
    "test:installer": "node --test tests/installer.test.mjs",
    "test:secrets": "node --test tests/secrets.test.mjs",
    "secret-sentinel": "node scripts/secret-sentinel.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "typecheck": "node scripts/check-syntax.mjs",
    "verify": "npm run lint && npm test && npm run secret-sentinel",
    "pack:dry-run": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucascruzfl/deskcomm-mcp-skill.git"
  },
  "homepage": "https://github.com/lucascruzfl/deskcomm-mcp-skill#readme",
  "bugs": {
    "url": "https://github.com/lucascruzfl/deskcomm-mcp-skill/issues"
  },
  "keywords": [
    "deskcomm",
    "mcp",
    "codex",
    "claude-code",
    "skill"
  ],
  "license": "MIT"
}
